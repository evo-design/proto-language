{
  "name": "metal3d_fampnn_ga",
  "description": "Compact enzyme-design example based on the dEVA Metal3D workflow. The program starts from the zinc-binding 2VVB scaffold, uses FAMPNN to seed a sequence-dependent population, then runs a generic genetic algorithm with ESM2 offspring mutation. Each proposal is threaded onto the scaffold, sidechain-packed with FAMPNN, and scored by Metal3D-Cat at the configured pocket residues.",
  "version": "1.0",
  "num_results": 2,
  "constructs": [
    {
      "id": "construct1",
      "type": "protein",
      "label": "2VVB zinc-binding enzyme scaffold",
      "segments": [
        {
          "id": "enzyme_chain",
          "label": "2VVB chain X",
          "sequence": "HHWGYGKHNGPEHWHKDFPIAKGERQSPVDIDTHTAKYDPSLKPLSVSYDQATSLRILNNGHAFNVEFDDSQDKAVLKGGPLDGTYRLIQFHFHWGSLDGQGSEHTVDKKKYAAELHLVHWNTKYGDFGKAVQQPDGLAVLGIFLKVGSAKPGLQKVVDVLDSIKTKGKSADFTNFDPRGLLPESLDYWTYPGSLTTPPLLECVTWIVLKEPISVSSEQVLKFRKLNFNGEGEPEELMVDNWRPAQPLKNRQIKASFK"
        }
      ]
    }
  ],
  "optimization_stages": [
    {
      "generators": [
        {
          "key": "fampnn",
          "label": "FAMPNN scaffold-conditioned sequence design",
          "targets": ["enzyme_chain"],
          "config": {
            "structure_inputs": [
              {
                "structure": "https://raw.githubusercontent.com/gelnesr/dEVA/main/inputs/2VVB.pdb",
                "chains_to_redesign": ["X"]
              }
            ],
            "output_chain_id": "X",
            "model_variant": "0.3",
            "temperature": 0.1,
            "batch_size": 4,
            "num_steps": 25,
            "seq_only": false,
            "repack_last": true,
            "psce_threshold": 0.3,
            "scn_diffusion_steps": 25,
            "scn_step_scale": 1.5,
            "device": "cuda",
            "verbose": false
          }
        },
        {
          "key": "esm2",
          "label": "ESM2 offspring mutation",
          "targets": [
            "enzyme_chain"
          ],
          "config": {
            "model_checkpoint": "esm2_t33_650M_UR50D",
            "masking_strategy": {
              "method": "random",
              "mask_fraction": 0.02,
              "temperature": 1.0
            },
            "sampling_method": "single_pass",
            "temperature": 1.0,
            "top_p": 1.0,
            "num_steps": 20,
            "schedule": "cosine",
            "strategy": "random",
            "temperature_annealing": true,
            "device": "cuda",
            "batch_size": 8
          }
        }
      ],
      "constraints": [
        {
          "key": "metal3d-probability",
          "label": "Metal3D-Cat pocket probability",
          "targets": ["enzyme_chain"],
          "weight": 1.0,
          "config": {
            "target_probability": 0.5,
            "candidate_residues": {
              "X": [94, 96, 106, 119, 199]
            },
            "structure_preparation": {
              "mode": "fampnn_pack_from_scaffold",
              "scaffold_structure": "https://raw.githubusercontent.com/gelnesr/dEVA/main/inputs/2VVB.pdb",
              "chain_ids": ["X"],
              "fampnn_pack_config": {
                "model_variant": "0.0",
                "num_samples_per_structure": 1,
                "batch_size": 4,
                "scn_diffusion_steps": 25,
                "scn_step_scale": 1.5,
                "device": "cuda",
                "verbose": false
              }
            },
            "metal3d_config": {
              "model_checkpoint": "metal3d-cat",
              "probability_threshold": 0.2,
              "cluster_distance_threshold": 7.0,
              "max_sites": 8,
              "device": "cuda",
              "verbose": false
            }
          }
        },
        {
          "key": "protein-complexity",
          "label": "Low-complexity filter",
          "targets": ["enzyme_chain"],
          "weight": 0.2,
          "config": {
            "max_low_complexity": 0.35
          }
        },
        {
          "key": "balanced-aa",
          "label": "Amino-acid balance filter",
          "targets": ["enzyme_chain"],
          "weight": 0.2,
          "config": {
            "min_aa_frequency": 0.01,
            "max_underrepresented_count": 8
          }
        }
      ],
      "optimizer": {
        "method": "genetic-algorithm",
        "config": {
          "num_generations": 3,
          "num_results": 2,
          "population_size": 8,
          "offspring_per_generation": 8,
          "elite_fraction": 0.25,
          "mutation_rate": 0.0,
          "initial_mutation_rate": 0.0,
          "crossover_rate": 0.75,
          "crossover_strategy": "uniform",
          "parent_selection": "tournament",
          "tournament_size": 3,
          "replacement": "elitist",
          "refine_offspring_with_generators": false,
          "tracking_interval": 1,
          "track_proposals": false,
          "verbose": false,
          "seed": 7
        }
      }
    }
  ]
}
